{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "labels": [
    "deps"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Track silo-server build",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/silo-server/silo-server:(?<currentValue>build-\\d+)"
      ],
      "depNameTemplate": "ghcr.io/silo-server/silo-server",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^build-(?<major>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group Immich (server + ml)",
      "matchPackageNames": [
        "/^ghcr\\.io/immich-app//"
      ],
      "groupName": "immich"
    },
    {
      "description": "Pin *arr digests",
      "matchPackageNames": [
        "/^ghcr\\.io/linuxserver//"
      ],
      "pinDigests": true
    },
    {
      "description": "Group linuxserver digest-only rebuilds",
      "matchPackageNames": [
        "/^(docker\\.io/)?linuxserver//"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "linuxserver rebuilds",
      "schedule": [
        "* * * * 0"
      ]
    },
    {
      "description": "Ignore silo-server",
      "matchManagers": [
        "kubernetes"
      ],
      "matchPackageNames": [
        "ghcr.io/silo-server/silo-server"
      ],
      "enabled": false
    }
  ],
  "ignorePaths": [
    "apps/*/actualbudget/*",
    "apps/*/adguardhome/*",
    "apps/*/audiobookshelf/*",
    "apps/*/bento-pdf/*",
    "apps/*/convertx/*",
    "apps/*/dispatcharr/*",
    "apps/*/firefly/*",
    "apps/*/flaresolverr/*",
    "apps/*/its-mytabs/*",
    "apps/*/linkding/*",
    "apps/*/pgadmin/*",
    "apps/*/qbittorrent/*",
    "apps/*/rustfs/*",
    "apps/*/stirling-pdf/*",
    "apps/*/transmute/*",
    "apps/*/tududi/*",
    "apps/*/twenty/*",
    "apps/*/wallos/*",
    "apps/*/wiki-js/*"
  ]
}

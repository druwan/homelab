{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "kubernetes": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "labels": [
    "deps"
  ],
  "packageRules": [
    {
      "description": "Only allow proper semver tags for LinuxServer/qBittorrent",
      "matchPackageNames": [
        "ghcr.io/linuxserver/qbittorrent"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r\\d+-ls(?<build>\\d+)$"
    },
    {
      "description": "Handle *arr",
      "matchPackageNames": [
        "ghcr.io/linuxserver/bazarr",
        "ghcr.io/linuxserver/prowlarr",
        "ghcr.io/linuxserver/radarr",
        "ghcr.io/linuxserver/sabnzbd",
        "ghcr.io/linuxserver/sonarr"
      ],
      "allowedVersions": "/^v?\\d+\\.\\d+\\.\\d+-ls\\d+$/",
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "Enable OCI Helm chart updates",
      "matchDatasources": [
        "oci"
      ],
      "matchManagers": [
        "helm"
      ],
      "extractVersion": "^(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioning": "semver",
      "pinDigests": true
    },
    {
      "description": "Pin digests for docker/ghcr images",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    }
  ]
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "labels": [
    "deps"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Track silo-server build",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/silo-server/silo-server:(?<currentValue>build-\\d+)"
      ],
      "depNameTemplate": "ghcr.io/silo-server/silo-server",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^build-(?<major>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group Immich (server + ml)",
      "matchPackageNames": [
        "/^ghcr\\.io/immich-app//"
      ],
      "groupName": "immich"
    },
    {
      "description": "Only allow major/minor for noisy packages",
      "matchPackageNames": [
        "/kube-prometheus-stack$/"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Pin *arr digests",
      "matchPackageNames": [
        "/^ghcr\\.io/linuxserver//"
      ],
      "pinDigests": true
    },
    {
      "description": "Group linuxserver digest-only rebuilds",
      "matchPackageNames": [
        "/^ghcr\\.io/linuxserver//"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "linuxserver rebuilds",
      "schedule": [
        "* * * * 0"
      ]
    },
    {
      "description": "Ignore silo-server",
      "matchManagers": [
        "kubernetes"
      ],
      "matchPackageNames": [
        "ghcr.io/silo-server/silo-server"
      ],
      "enabled": false
    }
  ]
}
